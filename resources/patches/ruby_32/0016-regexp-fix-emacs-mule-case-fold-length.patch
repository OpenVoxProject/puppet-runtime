From: Yusuke Endoh <mame@ruby-lang.org>
Date: 2026-10-28T23:33:28+09:00
Subject: [PATCH 10/15] Never return a negative length from the Emacs-Mule case-fold callback

Backport of Ruby 3.3 commit a479eb156def4b55d502c99b090429479ede2931
(ruby/ruby#20002, GHSA-wpqw-5qxg-m68r).

---
diff --git a/enc/emacs_mule.c b/enc/emacs_mule.c
index f92eb183cf..c7d93d2f53 100644
--- a/enc/emacs_mule.c
+++ b/enc/emacs_mule.c
@@ -272,24 +272,7 @@ mbc_case_fold(OnigCaseFoldType flag,
 	      const UChar** pp, const UChar* end, UChar* lower,
 	      OnigEncoding enc)
 {
-  int len;
-  const UChar* p = *pp;
-
-  if (ONIGENC_IS_MBC_ASCII(p)) {
-    *lower = ONIGENC_ASCII_CODE_TO_LOWER_CASE(*p);
-    (*pp)++;
-    return 1;
-  }
-  else {
-    int i;
-
-    len = mbc_enc_len(p, end, enc);
-    for (i = 0; i < len; i++) {
-      *lower++ = *p++;
-    }
-    (*pp) += len;
-    return len; /* return byte length of converted char to lower */
-  }
+  return onigenc_mbn_mbc_case_fold(enc, flag, pp, end, lower);
 }
 
 static UChar*
diff --git a/test/ruby/test_regexp.rb b/test/ruby/test_regexp.rb
index 8bd69c3abf..dc573c815f 100644
--- a/test/ruby/test_regexp.rb
+++ b/test/ruby/test_regexp.rb
@@ -1258,6 +1258,21 @@ def test_comment_separates_tokens
     end;
   end
 
+  def test_emacs_mule_case_fold_at_mid_character
+    assert_separately([], "#{<<~"begin;"}\n#{<<~'end;'}")
+    begin;
+      %w[Emacs-Mule stateless-ISO-2022-JP stateless-ISO-2022-JP-KDDI].each do |name|
+        enc = Encoding.find(name)
+        re = Regexp.new("(?i)(?!x)\x81\xa1{2}".b.force_encoding(enc))
+        assert_nil(re.match("\x81\xa1\x9c\xf0\xa1\xa1".b.force_encoding(enc)))
+        assert_equal(0, re =~ "\x81\xa1\x81\xa1".b.force_encoding(enc))
+        assert_equal(1, re =~ "\x81\xa2\x81\xa1\x81\xa1".b.force_encoding(enc))
+        re = Regexp.new("(?i)\x81\xa1".b.force_encoding(enc))
+        assert_equal(1, re =~ "\x9c\xf0\xa1\xa1\x81\xa1".b.force_encoding(enc))
+      end
+    end;
+  end
+
   def test_char_type
     check(/\u3042\d/, ["\u30421", "\u30422"])
 
