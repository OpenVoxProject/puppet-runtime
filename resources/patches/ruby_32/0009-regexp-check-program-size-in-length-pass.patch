From: Yusuke Endoh <mame@ruby-lang.org>
Date: 2026-11-18T13:00:28+09:00
Subject: [PATCH 3/15] Check the compiled program size while computing the length

Backport of Ruby 3.3 commit 8e7de382840f0b792c610872be4823acde060b94
(ruby/ruby#20000, GHSA-3p8q-wmhx-vm2w).
Adapted for Ruby 3.2, which lacks ruby/ruby#19505.

---
diff --git a/regcomp.c b/regcomp.c
index 9db32c4383..07933e4298 100644
--- a/regcomp.c
+++ b/regcomp.c
@@ -1661,23 +1661,24 @@ compile_length_tree(Node* node, regex_t* reg)
       r = compile_length_tree(NCAR(node), reg);
       if (r < 0) return r;
       len += r;
+      if (len > (int )MAX_COMPILED_PROGRAM_SIZE)
+	return ONIGERR_TOO_BIG_COMPILED_PROGRAM;
     } while (IS_NOT_NULL(node = NCDR(node)));
     r = len;
     break;
 
   case NT_ALT:
-    {
-      int n = 0;
-      len = 0;
-      do {
-	r = compile_length_tree(NCAR(node), reg);
-	if (r < 0) return r;
-	len += r;
-	n++;
-      } while (IS_NOT_NULL(node = NCDR(node)));
-      r = len;
-      r += (SIZE_OP_PUSH + SIZE_OP_JUMP) * (n - 1);
-    }
+    len = 0;
+    do {
+      r = compile_length_tree(NCAR(node), reg);
+      if (r < 0) return r;
+      len += r;
+      if (IS_NOT_NULL(NCDR(node)))
+	len += SIZE_OP_PUSH + SIZE_OP_JUMP;
+      if (len > (int )MAX_COMPILED_PROGRAM_SIZE)
+	return ONIGERR_TOO_BIG_COMPILED_PROGRAM;
+    } while (IS_NOT_NULL(node = NCDR(node)));
+    r = len;
     break;
 
   case NT_STR:
@@ -1740,6 +1741,8 @@ compile_length_tree(Node* node, regex_t* reg)
     break;
   }
 
+  if (r > (int )MAX_COMPILED_PROGRAM_SIZE)
+    return ONIGERR_TOO_BIG_COMPILED_PROGRAM;
   return r;
 }
 
@@ -1765,6 +1768,8 @@ compile_tree(Node* node, regex_t* reg)
 	if (NCDR(x) != NULL) {
 	  len += SIZE_OP_PUSH + SIZE_OP_JUMP;
 	}
+	if (len > (int )MAX_COMPILED_PROGRAM_SIZE)
+	  return ONIGERR_TOO_BIG_COMPILED_PROGRAM;
       } while (IS_NOT_NULL(x = NCDR(x)));
       pos = reg->used + len;  /* goal position */
 
@@ -5789,7 +5794,11 @@ onig_compile(regex_t* reg, const UChar* pattern, const UChar* pattern_end,
   UnsetAddrList  uslist;
 #endif
 
-  if (IS_NOT_NULL(einfo)) einfo->par = (UChar* )NULL;
+  if (IS_NOT_NULL(einfo)) {
+    einfo->enc     = reg->enc;
+    einfo->par     = (UChar* )NULL;
+    einfo->par_end = (UChar* )NULL;
+  }
 
 #ifdef RUBY
   scan_env.sourcefile = sourcefile;
diff --git a/test/ruby/test_regexp.rb b/test/ruby/test_regexp.rb
index 8f8473fe03..575ec65fbb 100644
--- a/test/ruby/test_regexp.rb
+++ b/test/ruby/test_regexp.rb
@@ -1885,4 +1885,11 @@ def test_nested_repeat_expansion_overflow
       end
     end;
   end
+
+  def test_too_big_compiled_program_length
+    k, rest = (2**32 - 217).divmod(100_001)
+    assert_raise_with_message(RegexpError, /too big compiled program/) do
+      Regexp.new("(?:#{'.{100000,}' * k}.{#{rest - 1},})?")
+    end
+  end
 end
