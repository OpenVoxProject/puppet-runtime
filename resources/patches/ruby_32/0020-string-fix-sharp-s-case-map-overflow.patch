From: Yusuke Endoh <mame@ruby-lang.org>
Date: 2026-10-28T22:55:06+09:00
Subject: [PATCH 14/15] Fix a heap buffer overflow in case mapping of the sharp s

Backport of Ruby 3.3 commit d8d4c02fff5a3f6418ed3c331b0fe116727b8eac
(ruby/ruby#20005, GHSA-34m4-m9fh-gqp5).

---
diff --git a/enc/iso_8859_1.c b/enc/iso_8859_1.c
index 7af0888c3e..5535358bb7 100644
--- a/enc/iso_8859_1.c
+++ b/enc/iso_8859_1.c
@@ -264,7 +264,7 @@ case_map(OnigCaseFoldType* flagP, const OnigUChar** pp,
   OnigUChar *to_start = to;
   OnigCaseFoldType flags = *flagP;
 
-  while (*pp < end && to < to_end) {
+  while (*pp < end && to_end - to > 1) {
     code = *(*pp)++;
     if (code == SHARP_s) {
       if (flags & ONIGENC_CASE_UPCASE) {
