From: Yusuke Endoh <mame@ruby-lang.org>
Date: 2026-10-29T00:39:31+09:00
Subject: [PATCH 7/15] Fix an out-of-bounds read in the case-insensitive exact match

Backport of Ruby 3.3 commit d0e82b6b854046d54d722fb455e76471dcf316b6
(ruby/ruby#20002, GHSA-wpqw-5qxg-m68r).

---
diff --git a/regexec.c b/regexec.c
index 8238326b93..e7f7276990 100644
--- a/regexec.c
+++ b/regexec.c
@@ -2494,6 +2494,7 @@ match_at(regex_t* reg, const UChar* str, const UChar* end,
 		    case_fold_flag,
 		    &s, end, lowbuf);
 	DATA_ENSURE(0);
+	if (len != enclen(encode, p, reg->p + reg->used)) goto fail;
 	q = lowbuf;
 	while (len-- > 0) {
 	  if (*p != *q) {
@@ -2583,6 +2584,7 @@ match_at(regex_t* reg, const UChar* str, const UChar* end,
 		      case_fold_flag,
 		      &s, end, lowbuf);
 	  DATA_ENSURE(0);
+	  if (len > endp - p) goto fail;
 	  q = lowbuf;
 	  while (len-- > 0) {
 	    if (*p != *q) goto fail;
diff --git a/test/ruby/test_regexp.rb b/test/ruby/test_regexp.rb
index a042826ff1..4aa5988b95 100644
--- a/test/ruby/test_regexp.rb
+++ b/test/ruby/test_regexp.rb
@@ -1413,6 +1413,33 @@ def test_unicode
     assert_match(/^\u03b9\u0308\u0301$/i, "\u0390")
   end
 
+  def test_ignorecase_fold_longer_than_operand
+    %w[UTF-16LE UTF-16BE UTF-32LE UTF-32BE].each do |enc|
+      tail = "\u0103\u3042\u3044"
+      s = ("x" * 16 + "\u1E98" + "y" * 8).encode(enc)
+      re = Regexp.new(("x" * 16 + "(?i:w)" + tail).encode(enc))
+      assert_match(re, ("x" * 16 + "W" + tail).encode(enc))
+      assert_no_match(re, s)
+      re = Regexp.new(("(?i:" + "x" * 16 + "w)" + tail).encode(enc))
+      assert_match(re, ("x" * 16 + "W" + tail).encode(enc))
+      assert_no_match(re, s)
+      re = Regexp.new("(?-i:xyz)t(?-i:\u0103)".encode(enc), Regexp::IGNORECASE)
+      assert_match(re, "xyzT\u0103".encode(enc))
+      assert_no_match(re, "xyz\u1E97".encode(enc))
+    end
+
+    assert_separately([], "#{<<~"begin;"}\n#{<<~'end;'}")
+    begin;
+      enc = Encoding::UTF_16LE
+      re = Regexp.new("(?i:w)\u6203AB".encode(enc))
+      assert_match(re, "W\u6203AB".encode(enc))
+      assert_no_match(re, "\u1E98\u6203AB".encode(enc))
+      re = Regexp.new("(?i:xw)\u6203AB".encode(enc))
+      assert_match(re, "xW\u6203AB".encode(enc))
+      assert_no_match(re, "x\u1E98\u6203AB".encode(enc))
+    end;
+  end
+
   def test_unicode_age
     assert_match(/^\p{Age=6.0}$/u, "\u261c")
     assert_match(/^\p{Age=1.1}$/u, "\u261c")
